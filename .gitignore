# ------------------------------------------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
/node_modules
/.pnp
.pnp
.pnp.js
.pnp.*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ------------------------------------------------------------------------------
# Next.js Build Outputs & Caches
# ------------------------------------------------------------------------------
/.next/
.next/
/out/
out/
/build
build/
/dist
dist/
.next-dev/
.next-stale-backup/

# ------------------------------------------------------------------------------
# TypeScript & Bundler Cache
# ------------------------------------------------------------------------------
*.tsbuildinfo
tsconfig.tsbuildinfo
next-env.d.ts

# ------------------------------------------------------------------------------
# Environment Variables & Security Secrets
# ------------------------------------------------------------------------------
.env
.env*.local
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local

# Allow tracked template example
!.env.example

# SSL & Crypto Certificates / Keys
*.pem
*.key
*.cert
*.crt

