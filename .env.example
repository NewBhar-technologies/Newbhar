# ==============================================================================
# NEWBHAR TECHNOLOGIES — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# In Vercel or cloud host, configure these in Project Settings -> Environment Variables.
# NEVER commit .env.local or expose secret keys in client-side bundles.
# ==============================================================================

# Site URL (Canonical URL, sitemaps, Open Graph)
NEXT_PUBLIC_SITE_URL=https://newbhar.com

# Supabase PostgreSQL Configuration
# Found in: Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Server-Only Privileged Service Role Key (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Authentication (jose JWT signing secret - minimum 32 random characters)
ADMIN_JWT_SECRET=your_super_secret_64_character_hex_or_passphrase_here

# First-time Super Admin Initialization (Used only once to seed the first admin if none exists)
INITIAL_ADMIN_EMAIL=admin@newbhar.com
INITIAL_ADMIN_PASSWORD=your_initial_secure_admin_password_here

# ==============================================================================
# Official Company Email & Inquiries Configuration
# ==============================================================================
# Publicly accessible contact emails (optional overrides; default to official domain)
NEXT_PUBLIC_CONTACT_EMAIL=contact@newbhar.com
NEXT_PUBLIC_INFO_EMAIL=info@newbhar.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@newbhar.com

# Server-Side Inbound Notification Target Inboxes (Direct Resend Destination)
NOTIFICATION_EMAIL=newbhartechnologies@gmail.com
CONTACT_RECIPIENT_EMAIL=newbhartechnologies@gmail.com
INFO_RECIPIENT_EMAIL=info@newbhar.com
SUPPORT_RECIPIENT_EMAIL=support@newbhar.com

# Outgoing Email Dispatch (Resend or SMTP)
# IMPORTANT ARCHITECTURAL NOTE:
# - Cloudflare Email Routing only handles INCOMING mail routing to target inboxes.
#   It does NOT provide an outbound SMTP service.
# - Do NOT configure Cloudflare forwarding addresses as SMTP credentials.
# - For sending outbound emails (contact notifications, auto-responses, template emails),
#   configure a verified transactional email provider like Resend (RESEND_API_KEY)
#   or external SMTP credentials.
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="Newbhar Technologies <contact@newbhar.com>"

# Optional Outgoing SMTP Configuration (Retrieved from env variables if configured)
# SMTP_HOST=smtp.mailprovider.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# SMTP_SECURE=false

# Supabase Media Storage Bucket
SUPABASE_STORAGE_BUCKET=newbhar-media
